{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Recipe",
  "$defs": {
    "Anchor": {
      "type": "object",
      "properties": {
        "part": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "u": {
          "type": "number"
        },
        "v": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "required": [
        "part",
        "u",
        "v"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "BonePose": {
      "type": "object",
      "properties": {
        "part": {
          "type": "string"
        },
        "joint": {
          "type": "string"
        },
        "degrees": {
          "type": "number"
        },
        "stretch": {
          "type": "number"
        },
        "turn": {
          "type": "number"
        },
        "lean": {
          "type": "number"
        },
        "mode": {
          "enum": [
            "free",
            "limited",
            "locked"
          ]
        },
        "keepVolume": {
          "type": "boolean"
        },
        "twist": {
          "type": "number"
        }
      },
      "required": [
        "part",
        "joint"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "EyeLook": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "lowerLid": {
          "type": "number"
        },
        "frontNarrowing": {
          "type": "number"
        },
        "tilt": {
          "type": "number"
        },
        "openingTilt": {
          "type": "number"
        },
        "lookOut": {
          "type": "number"
        },
        "irisSize": {
          "type": "number"
        },
        "irisRatio": {
          "type": "number"
        },
        "irisForward": {
          "type": "number"
        },
        "irisUp": {
          "type": "number"
        },
        "pupilSize": {
          "type": "number"
        },
        "slit": {
          "type": "boolean"
        },
        "highlightSize": {
          "type": "number"
        },
        "highlightForward": {
          "type": "number"
        },
        "highlightUp": {
          "type": "number"
        },
        "lid": {
          "type": "boolean"
        },
        "lashes": {
          "type": "boolean"
        },
        "brow": {
          "type": "boolean"
        },
        "browRaise": {
          "type": "number"
        },
        "browTilt": {
          "type": "number"
        },
        "white": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "iris": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pupil": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "highlight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "GarmentSlot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "GroupRole": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "lipLine",
            "inner",
            "teeth",
            "tongue",
            "corners"
          ]
        },
        "ink": {
          "type": "boolean"
        },
        "fill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "role"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Hide": {
      "description": "The part is not built while the garment is worn.",
      "type": "object",
      "properties": {
        "type": {
          "const": "hide"
        }
      },
      "required": [
        "type"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "JointAngle": {
      "type": "object",
      "properties": {
        "part": {
          "type": "string"
        },
        "joint": {
          "type": "string"
        },
        "degrees": {
          "type": "number"
        }
      },
      "required": [
        "part",
        "joint",
        "degrees"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "LooseEnd": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "v": {
          "type": "number"
        },
        "bones": {
          "type": "integer"
        },
        "fromHem": {
          "type": "boolean"
        },
        "followThrough": {
          "type": "boolean"
        },
        "spring": {
          "type": "number"
        },
        "collideBody": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "branch"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "MarkControls": {
      "type": "object",
      "properties": {
        "open": {
          "type": "number"
        },
        "expressionBlend": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "mouthShape": {
          "anyOf": [
            {
              "enum": [
                "SMILE",
                "FROWN",
                "O",
                "GRIMACE"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "MarkFlight": {
      "type": "object",
      "properties": {
        "along": {
          "type": "number"
        },
        "across": {
          "type": "number"
        },
        "out": {
          "type": "number"
        }
      },
      "required": [
        "along",
        "across",
        "out"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "MarkGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupRole"
          }
        },
        "controls": {
          "$ref": "#/$defs/MarkControls"
        }
      },
      "required": [
        "id",
        "name",
        "roles"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "MarkVersion": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Anchor"
          }
        },
        "width": {
          "$ref": "#/$defs/MarkWidth"
        }
      },
      "required": [
        "points"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "MarkWidth": {
      "type": "object",
      "properties": {
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WidthStop"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Outfit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "picks": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Recipe": {
      "description": "A Squash character described as parts, outlines, colours, face, clothes and poses; built into a character file by sending the document commands it stands for.",
      "type": "object",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "description": "The recipe grammar version.",
          "type": "integer",
          "minimum": 1.0,
          "maximum": 1.0
        },
        "id": {
          "description": "The character's id, also the name of the files a build writes.",
          "type": "string"
        },
        "name": {
          "description": "The character's name as the app shows it.",
          "type": "string"
        },
        "plan": {
          "description": "The body plan the character starts on: blank, biped, bird, canine-quadruped or fish.",
          "type": "string"
        },
        "planVersion": {
          "description": "The plan's version; the newest shipped when left out.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1.0
            },
            {
              "type": "null"
            }
          ]
        },
        "palette": {
          "description": "Named colours, in order. Every colour the recipe uses is a slot named here.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeSlot"
          }
        },
        "parts": {
          "description": "The parts, each after the part it sits on. A garment's own parts (shades, a heel, a buckle) name their garment.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipePart"
          }
        },
        "eyes": {
          "description": "Painted eyes on a head.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeEye"
          }
        },
        "expressions": {
          "description": "Named expressions: joint angles of the face's parts, as ears back or a dropped jaw.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeExpression"
          }
        },
        "wardrobe": {
          "description": "Clothes: slots, garments and outfits.",
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeWardrobe"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayPose": {
          "description": "The pose the character is saved and shown in, over the rest it is built in: a biped's arms brought down from A-pose.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BonePose"
          }
        },
        "poses": {
          "description": "Named poses the build renders besides the display pose; not saved in the character.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/BonePose"
            }
          }
        }
      },
      "required": [
        "format",
        "id",
        "name"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeChange": {
      "oneOf": [
        {
          "$ref": "#/$defs/Hide"
        },
        {
          "$ref": "#/$defs/Redraw"
        },
        {
          "$ref": "#/$defs/Swap"
        },
        {
          "$ref": "#/$defs/Through"
        }
      ]
    },
    "RecipeCover": {
      "description": "The garment over one part. u runs along the part, past 1 to run on past its end or below 0 before its start; v round it, a span under 1 leaving an opening.",
      "type": "object",
      "properties": {
        "part": {
          "type": "string"
        },
        "from": {
          "description": "Where along the part it starts.",
          "type": "number"
        },
        "to": {
          "description": "Where along the part it ends.",
          "type": "number"
        },
        "fromV": {
          "description": "Where round the part it starts; below 0 to cross v 0.",
          "type": "number"
        },
        "toV": {
          "description": "Where round the part it ends.",
          "type": "number"
        },
        "ease": {
          "description": "How far it stands off the part where no outline takes it further, when the garment has no fit.",
          "type": "number"
        },
        "outlines": {
          "description": "Side and Top outlines along the part's own x where the cloth stands off further, as a skirt's flare.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "side",
              "top",
              "front"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/RecipeOutline"
          }
        }
      },
      "required": [
        "part"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeExpression": {
      "description": "A named expression.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "joints": {
          "description": "Joint angles, each naming its part and joint; a mirrored part names each side's id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JointAngle"
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeEye": {
      "description": "A painted eye on a head. Place it by u and v, or by face [x, y] seen from straight ahead (x to the character's left).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "on": {
          "description": "The head it is painted on.",
          "type": "string"
        },
        "patch": {
          "description": "The patch u and v lie on.",
          "type": "string"
        },
        "u": {
          "description": "Where along the head its middle sits.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "v": {
          "description": "Where round the head its middle sits.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "face": {
          "description": "Its middle as [x, y] on the face seen from straight ahead, in place of u and v.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "look": {
          "description": "How it looks: opening, iris, pupil, highlight, lid, lashes, brow, and their palette slots (white, iris, pupil, highlight, ink).",
          "$ref": "#/$defs/EyeLook"
        },
        "front": {
          "description": "How it looks when the head is seen from the front; the look alone when left out.",
          "anyOf": [
            {
              "$ref": "#/$defs/EyeLook"
            },
            {
              "type": "null"
            }
          ]
        },
        "fromFront": {
          "description": "How far from its look to the front look a front view goes, 0 to 1.",
          "type": "number"
        },
        "gazeForward": {
          "description": "Gaze toward the head's front, a share of the opening's half width.",
          "type": "number"
        },
        "gazeUp": {
          "description": "Gaze up, a share of the opening's half height.",
          "type": "number"
        },
        "mirrored": {
          "description": "Whether it is painted again on the other side of the head.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "on"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeFur": {
      "description": "Fur on a part: how its strokes show and patches of stroke roots.",
      "type": "object",
      "properties": {
        "spacing": {
          "description": "Pixels between strokes on screen.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "length": {
          "description": "Pixels a stroke reaches.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "patches": {
          "description": "Patches of stroke roots laid in staggered rows.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeFurPatch"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeFurPatch": {
      "description": "A patch of fur stroke roots in staggered rows, each root a fur mark named <name>-<row>-<column>.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rows": {
          "description": "How many rows along the part.",
          "type": "integer"
        },
        "columns": {
          "description": "How many roots round it in each row.",
          "type": "integer"
        },
        "u": {
          "description": "[from, to] along the part.",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "v": {
          "description": "[from, to] round the part; [0, 1] all round.",
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "name",
        "rows",
        "columns",
        "u",
        "v"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeGarment": {
      "description": "A garment: a shell over the parts it covers, standing off them by its fit, and what it does to the parts under it.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slot": {
          "description": "The wardrobe slot it goes in.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "layer": {
          "description": "Counted out from the skin: under a waistband 1, a waistband 2, over both 3.",
          "type": "integer"
        },
        "color": {
          "description": "Its palette slot.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit": {
          "description": "How far it stands off the body, in body units; each cover's own ease when left out.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "partFits": {
          "description": "A fit for one covered part (a pair by its left side), over the garment's.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "inkHem": {
          "description": "Whether its edges are inked.",
          "type": "boolean"
        },
        "joins": {
          "description": "Covered parts whose join with the next covered part is inked.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "covers": {
          "description": "The parts it covers, one cover each; a pair's cover names its left side and covers both.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeCover"
          }
        },
        "changes": {
          "description": "What it does to body parts under it, by part (a pair by its left side).",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/RecipeChange"
          }
        },
        "looseEnds": {
          "description": "Loose ends it hangs, as a scarf's tails.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LooseEnd"
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeLineWeight": {
      "description": "Heavier lines within radius of a stretch of the part.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "points": {
          "description": "The stretch as [u, v] on the part.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "radius": {
          "description": "How far it reaches, a share of the part's length.",
          "type": "number"
        },
        "amount": {
          "description": "How much heavier: a line's weight times 1 plus this.",
          "type": "number"
        },
        "patch": {
          "description": "The patch points lie on.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "points",
        "radius",
        "amount"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "RecipeMark": {
      "description": "A mark: an ink line through its places, or a fur stroke from its one root. Give its places one way: points, face or anchors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "line, fur or floating.",
          "enum": [
            "line",
            "fur",
            "floating"
          ]
        },
        "patch": {
          "description": "The patch points lie on.",
          "type": "string"
        },
        "points": {
          "description": "Its places as [u, v] on the part.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "face": {
          "description": "On a head: its places as [x, y] on the face seen from straight ahead.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "anchors": {
          "description": "Its places as anchors, each naming its part.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Anchor"
              }
            },
            {
              "type": "null"
            }
          ]
