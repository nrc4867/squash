{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BodyPlan",
  "$defs": {
    "BodyPlan": {
      "description": "A body plan: a root part and the sockets and slots hung from it.",
      "type": "object",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "description": "The grammar version of the file.",
          "type": "integer",
          "minimum": 1.0,
          "maximum": 1.0
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1.0
        },
        "name": {
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/PlanRoot"
        },
        "sockets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanSocket"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanSlot"
          }
        },
        "palette": {
          "description": "The palette a new character on this plan starts with.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanColor"
          }
        },
        "base": {
          "description": "The palette slot a new part on this plan starts with.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "id",
        "version",
        "name",
        "root",
        "sockets"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "PlanColor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/SlotColor"
        }
      },
      "required": [
        "name",
        "color"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "PlanRoot": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string"
        },
        "rest": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "template",
        "rest"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "PlanSlot": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "on": {
          "type": "string"
        },
        "takes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "on",
        "takes"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "PlanSocket": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "on": {
          "type": "string"
        },
        "u": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "v": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "pair": {
          "description": "Gives this socket a mirrored twin.",
          "anyOf": [
            {
              "enum": [
                "x"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "outward": {
          "description": "Which way a part on this socket sinks into its parent: back along its own axis, or along the surface's normal.",
          "enum": [
            "axis",
            "normal"
          ]
        },
        "takes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "boolean"
        },
        "sink": {
          "description": "Multiplies how deep a part on this socket sits inside its parent.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 4.0
        }
      },
      "required": [
        "name",
        "on",
        "u",
        "v",
        "takes"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "SlotColor": {
      "type": "object",
      "properties": {
        "red": {
          "type": "number"
        },
        "green": {
          "type": "number"
        },
        "blue": {
          "type": "number"
        }
      },
      "required": [
        "red",
        "green",
        "blue"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  }
}
