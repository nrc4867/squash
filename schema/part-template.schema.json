{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PartTemplate",
  "$defs": {
    "Area": {
      "description": "A tagged region weights and shading can read, and that Fill colors whole.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "area"
        },
        "name": {
          "type": "string"
        },
        "if": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "u": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "v": {
          "description": "Around the surface. An end below its start runs on past 1 to it, crossing the seam at v = 0.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "tag": {
          "enum": [
            "rigid",
            "soft",
            "inner",
            "fill"
          ]
        },
        "patch": {
          "description": "The patch it lies on, or every one of a row of patches.",
          "type": "string"
        },
        "color": {
          "description": "A palette slot it shows until it is filled.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "u",
        "v",
        "tag"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "AxisSpec": {
      "description": "The rest direction before anything is drawn.",
      "type": "object",
      "properties": {
        "rest": {
          "description": "From the socket end toward the tip, in body space.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "length": {
          "description": "How long the axis is with nothing drawn, in body units; the size parameter multiplies it.",
          "type": "number"
        },
        "bend": {
          "description": "How far the axis sits toward the underside at bendAt with nothing drawn, as a fraction of its length.",
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "bendAt": {
          "description": "Where along the axis it bends.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "bearsWeight": {
          "description": "Whether the part stands on the ground, so a lean on one such part shortens the others to keep them all on it.",
          "type": "boolean"
        }
      },
      "required": [
        "rest"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Blend": {
      "description": "A fillet where the part's patches cross, grown by moving the vertices near each crossing; every patch keeps its grid.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "blend"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "if": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "description": "How wide the fillet reaches, as a fraction of the axis length; the surface grows by at most a quarter of it.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            }
          ]
        },
        "apart": {
          "description": "How much of the fillet two surfaces facing each other across a gap still get, from 0 to 1.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "between": {
          "description": "The pairs of patches it fillets, by name; a repeating block's name covers all its patches. Every pair when left out.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "still": {
          "description": "The patches that keep their place and lend only their shape, by name; the patches they meet then cover the whole fillet.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "socket": {
          "description": "Whether it also fillets where the part comes out of the part it sits on, moving the part's vertices near that crossing and keeping the other's.",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "radius"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Block": {
      "oneOf": [
        {
          "$ref": "#/$defs/Area"
        },
        {
          "$ref": "#/$defs/Blend"
        },
        {
          "$ref": "#/$defs/Cap"
        },
        {
          "$ref": "#/$defs/Joint"
        },
        {
          "$ref": "#/$defs/Landmark"
        },
        {
          "$ref": "#/$defs/Membrane"
        },
        {
          "$ref": "#/$defs/Pad"
        },
        {
          "$ref": "#/$defs/Skull"
        },
        {
          "$ref": "#/$defs/Socket"
        },
        {
          "$ref": "#/$defs/ToeRow"
        },
        {
          "$ref": "#/$defs/Tube"
        }
      ]
    },
    "Cap": {
      "description": "Closes an end that is not a socket.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "cap"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "if": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "enum": [
            "start",
            "end"
          ]
        },
        "shape": {
          "enum": [
            "round",
            "flat",
            "pointed"
          ]
        }
      },
      "required": [
        "kind",
        "end"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "CountRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 2.0
        },
        "max": {
          "type": "integer",
          "minimum": 2.0
        }
      },
      "required": [
        "min",
        "max"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Digit": {
      "description": "One digit of a toe row moved and angled apart from the fan, as a thumb is; a field left out keeps the row's.",
      "type": "object",
      "properties": {
        "index": {
          "description": "The digit's place in the row, from 0.",
          "type": "integer",
          "minimum": 0.0
        },
        "u": {
          "description": "Where the digit runs along the axis, in place of the row's span.",
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "across": {
          "description": "Where across the row the digit's root sits, -1 at the first side and 1 at the last.",
          "anyOf": [
            {
              "type": "number",
              "minimum": -1.5,
              "maximum": 1.5
            },
            {
              "type": "null"
            }
          ]
        },
        "angle": {
          "description": "Degrees the digit turns from the axis toward the row's last side, in place of its place in the fan; past 90 either way it points back from its root.",
          "anyOf": [
            {
              "type": "number",
              "minimum": -180.0,
              "maximum": 180.0
            },
            {
              "type": "null"
            }
          ]
        },
        "joints": {
          "description": "Where this digit's joints sit as shares of its span from its root, in place of the row's.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "description": "Degrees this digit's joints turn within, in place of the row's, so each digit of a row can close along its own path.",
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "index"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "DigitJoints": {
      "description": "Joints along every digit of the row: where each sits as a share of the digit's span from its root, about which hinge, within which limits.",
      "type": "object",
      "properties": {
        "at": {
          "description": "Each joint's place along a digit, from 0 at its root to 1 at its tip, ascending.",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "hinge": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "limits": {
          "description": "Degrees; a positive tip turns the digit toward the row's underside.",
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "at"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "GenericSpec": {
      "description": "A generic template: each part chooses its section profile, the views that set it, and its rings and segments; the template's section, views and topology are the defaults.",
      "type": "object",
      "properties": {
        "rings": {
          "description": "The fewest and most rings a part may take.",
          "$ref": "#/$defs/CountRange"
        },
        "segments": {
          "description": "The fewest and most control points a part's section may take.",
          "$ref": "#/$defs/CountRange"
        }
      },
      "required": [
        "rings",
        "segments"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "GrainSpec": {
      "description": "How the part's fur lies until a comb changes it.",
      "type": "object",
      "properties": {
        "toward": {
          "description": "The end of the axis fur runs toward.",
          "enum": [
            "start",
            "end"
          ]
        },
        "lift": {
          "description": "How far a stroke rises for each unit it runs along the surface, where no ruff says otherwise.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "ruffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuffSpec"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Joint": {
      "description": "A bone boundary; bones are the spans between joints in u order.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "joint"
        },
        "name": {
          "type": "string"
        },
        "if": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "u": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "v": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "null"
            }
          ]
        },
        "hinge": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "limits": {
          "description": "Degrees.",
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "stretch": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name",
        "u",
        "hinge"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Landmark": {
      "description": "A named surface point face marks and sets anchor to.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "landmark"
        },
        "name": {
          "type": "string"
        },
        "if": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "u": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "v": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "pair": {
          "anyOf": [
            {
              "enum": [
                "x"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "u",
        "v"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Membrane": {
      "description": "A web spanned between neighbouring digits of a toe row listed before it, or a digit and the part's own run, one patch a pair, named for the membrane and the pair's first digit.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "membrane"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "if": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "on": {
          "description": "The toe row whose digits it spans. The row is listed before the membrane.",
          "type": "string"
        },
        "reach": {
          "description": "How far up the digits its free edge meets them, as a share of each digit's span from its root.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            }
          ]
        },
        "sag": {
          "description": "How far its free edge dips toward its middle, as a share of its reach.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            }
          ]
        },
        "thickness": {
          "description": "How thick it is half way between two digits, as a share of their thickness.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            }
          ]
        },
        "rings": {
          "description": "Rings across it, from one digit to the other.",
          "type": "integer",
          "minimum": 4.0
        },
        "segments": {
          "description": "Points round each ring, an even number.",
          "type": "integer",
          "minimum": 6.0
        },
        "between": {
          "description": "The pairs of digits it spans; each digit with the next when left out, leaving out a digit turned back.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MembranePair"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "on",
        "reach",
        "thickness",
        "rings",
        "segments"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "MembranePair": {
      "description": "Two rails a membrane spans: a digit of the row by its place, and a second digit or, with along, the part's own run; reach in place of the membrane's.",
      "type": "object",
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 0.0
        },
        "second": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0.0
            },
            {
              "type": "null"
            }
          ]
        },
        "along": {
          "description": "The part's own run as the second rail, from u at the rail's root to u at its edge, in place of a second digit.",
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reach": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "first"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "MountSpec": {
      "description": "The point of a closed part that sits on its socket, in place of its axis start.",
      "type": "object",
      "properties": {
        "u": {
          "description": "Along the axis.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "v": {
          "description": "Around the surface; underneath is 0.5.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "u",
        "v"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "Pad": {
      "description": "A raised area tagged with a palette slot, on the first run listed before it that reaches its u.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "pad"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "if": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "u": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "null"
            }
          ]
        },
        "v": {
          "description": "Around the surface; underneath when left out.",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            {
              "type": "null"
            }
          ]
        },
        "on": {
          "description": "The toe row this pad repeats along, in place of u. The row is listed before the pad.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^\\$[a-z][a-zA-Z0-9]*$"
            }
          ]
        },
        "color": {
          "description": "A palette slot.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rings": {
          "description": "Rings from the pad's inner point to its apex.",
          "type": "integer",
          "minimum": 3.0
        },
        "segments": {
          "description": "Points around each of the pad's rings.",
          "type": "integer",
          "minimum": 3.0
        }
      },
      "required": [
        "kind",
        "size",
        "rings",
        "segments"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "ParamSpec": {
      "type": "object",
      "properties": {
        "default": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "description": "The only values it takes, ascending, in place of min and max. A value between them is never offered.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "default"
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "PartTemplate": {
      "description": "A part template: axis, open end, topology, blocks, parameters and which view sets what.",
      "type": "object",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "description": "The grammar version of the file.",
          "type": "integer",
          "minimum": 1.0,
          "maximum": 1.0
        },
        "id": {
          "type": "string"
        },
        "version": {
          "description": "The template's own version; changes when its topology or joints change.",
          "type": "integer",
          "minimum": 1.0
        },
        "name": {
          "type": "string"
        },
        "role": {
