{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "ear",
  "version": 1,
  "name": "Ear",
  "axis": { "rest": [0, 0.96, -0.28], "length": 0.3 },
  "openEnd": "start",
  "topology": { "rings": 16, "segments": 12 },
  "views": { "side": "height", "top": "width", "front": "section" },
  "section": "lens",
  "params": {
    "size":  { "default": 1.0,  "min": 0.4, "max": 2.5 },
    "width": { "default": 0.35, "min": 0.1, "max": 0.8 },
    "cup":   { "default": 0.0,  "min": 0.0, "max": 0.6 }
  },
  "blocks": [
    { "kind": "tube",  "u": [0.0, 1.0], "radius": "$width", "taper": 0.4, "cup": "$cup" },
    { "kind": "cap",   "end": "end", "shape": "pointed" },
    { "kind": "joint", "name": "base", "u": 0.0, "hinge": "y", "limits": [-40, 40] },
    { "kind": "joint", "name": "fold", "u": 0.6, "hinge": "x", "limits": [0, 150] },
    { "kind": "joint", "name": "tip", "u": 1.0, "hinge": "x", "limits": [-20, 20] },
    { "kind": "area",  "name": "inner", "u": [0.1, 0.9], "v": [0.0, 0.5], "tag": "inner" }
  ]
}
