{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "scute",
  "version": 1,
  "name": "Scute",
  "role": "other",
  "axis": { "rest": [0, 1, 0], "length": 0.12 },
  "openEnd": "start",
  "topology": { "rings": 14, "segments": 16 },
  "views": { "side": "height", "top": "width" },
  "section": "lens",
  "params": {
    "size":  { "doc": "Scales the part: its drawn length and width together.", "default": 1.0, "min": 0.1, "max": 2.5 },
    "girth": { "doc": "Thickness with nothing drawn, a fraction of the length; drawn outlines set the shape instead.", "default": 0.14, "min": 0.04, "max": 0.6 },
    "width": { "doc": "How much wider than thick the plate is, with nothing drawn.", "default": 4.5, "min": 1.0, "max": 8.0 },
    "taper": { "doc": "The plate's width at its free edge as a share of its width at its root.", "default": 1.0, "min": 0.3, "max": 1.6 }
  },
  "blocks": [
    { "kind": "tube", "u": [0.0, 1.0], "radius": "$girth", "taper": "$taper", "width": "$width" },
    { "kind": "cap",  "end": "end", "shape": "round" },
    { "kind": "area", "name": "edge", "u": [0.72, 1.0], "v": [0, 1], "tag": "fill" }
  ]
}
