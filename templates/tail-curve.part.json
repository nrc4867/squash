{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "tail-curve",
  "version": 1,
  "name": "Curved tail",
  "role": "tail",
  "axis": {
    "rest": [-1, 0.2, 0], "length": 0.7,
    "curve": [
      { "along": "$place1Along", "up": "$place1Up" },
      { "along": "$place2Along", "up": "$place2Up" },
      { "along": "$place3Along", "up": "$place3Up" }
    ]
  },
  "openEnd": "start",
  "topology": { "rings": 81, "segments": 12 },
  "views": { "side": "height", "top": "width", "front": "cap" },
  "section": "circle",
  "params": {
    "size":        { "doc": "Scales the part: its length along the curve and its thickness together.", "default": 1.0, "min": 0.4, "max": 2.5 },
    "thickness":   { "doc": "Radius at the root with nothing drawn, a fraction of the length; drawn outlines set the shape instead.", "default": 0.07, "min": 0.02, "max": 0.4 },
    "taper":       { "doc": "Radius at the tip as a fraction of the radius at the root.", "default": 0.35, "min": 0.05, "max": 1.0 },
    "place1Along": { "doc": "The curve's first place after the root, along the rest direction, as a fraction of the length.", "default": 0.3, "min": -1.0, "max": 1.5 },
    "place1Up":    { "doc": "The curve's first place after the root, toward the top, as a fraction of the length.", "default": -0.1, "min": -1.0, "max": 1.0 },
    "place2Along": { "doc": "The curve's second place, along the rest direction.", "default": 0.6, "min": -1.0, "max": 1.5 },
    "place2Up":    { "doc": "The curve's second place, toward the top.", "default": -0.04, "min": -1.0, "max": 1.0 },
    "place3Along": { "doc": "The curve's last place, the tip, along the rest direction.", "default": 0.85, "min": -1.0, "max": 1.5 },
    "place3Up":    { "doc": "The curve's last place, the tip, toward the top.", "default": 0.2, "min": -1.0, "max": 1.0 }
  },
  "blocks": [
    { "kind": "tube", "u": [0.0, 1.0], "radius": "$thickness", "taper": "$taper" },
    { "kind": "cap", "end": "end", "shape": "round" },
    { "kind": "joint", "name": "root", "u": 0.0, "hinge": "x", "limits": [-60, 60] },
    { "kind": "joint", "name": "tail1", "u": 0.1, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail2", "u": 0.2, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail3", "u": 0.3, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail4", "u": 0.4, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail5", "u": 0.5, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail6", "u": 0.6, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail7", "u": 0.7, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail8", "u": 0.8, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tail9", "u": 0.9, "hinge": "x", "limits": [-30, 30] },
    { "kind": "joint", "name": "tip", "u": 1.0, "hinge": "x", "limits": [-30, 30] },
    { "kind": "area", "name": "tip", "u": [0.8, 1.0], "v": [0, 1], "tag": "fill" },
    { "kind": "area", "name": "base", "u": [0.0, 0.25], "v": [0, 1], "tag": "fill" },
    { "kind": "area", "name": "underside", "u": [0.0, 0.8], "v": [0.3, 0.7], "tag": "fill" }
  ]
}
