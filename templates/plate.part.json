{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "plate",
  "version": 1,
  "name": "Plate",
  "role": "fin",
  "axis": { "rest": [-0.34, 0.94, 0], "length": 0.16 },
  "openEnd": "start",
  "topology": { "rings": 16, "segments": 12 },
  "views": { "side": "height", "top": "width" },
  "section": "lens",
  "params": {
    "size":  { "default": 1.0,  "min": 0.1, "max": 2.5 },
    "girth": { "default": 0.55, "min": 0.1, "max": 1.0 }
  },
  "blocks": [
    { "kind": "tube", "u": [0.0, 1.0], "radius": "$girth", "taper": 0.55, "openV": true },
    { "kind": "cap",  "end": "end", "shape": "round" }
  ]
}
