    "side": "height",
    "top": "width",
    "front": "cap"
  },
  "section": "circle",
  "join": {
    "blend": 0.035
  },
  "params": {
    "size": {
      "doc": "Scales the part: its drawn length and width together.",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5
    },
    "toes": {
      "doc": "1 for a single hoof (a horse), 2 for a cloven hoof, two toes side by side (a cow, a goat, a deer).",
      "default": 1,
      "values": [
        1,
        2
      ]
    },
    "cleft": {
      "doc": "How far apart a cloven hoof's two toes stand, as a multiple of their gap.",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0
    },
    "splay": {
      "doc": "How far a cloven hoof's toes turn apart toward the ground, as a multiple: below 1 they stand together, above it they part a little more.",
      "default": 1.0,
      "min": 0.3,
      "max": 2.0
    },
    "flare": {
      "doc": "How much wider each hoof is at the sole than at the coronet.",
      "default": 1.25,
      "min": 1.0,
      "max": 1.6
    },
    "height": {
      "doc": "How tall the hoof wall stands from the sole to the coronet, as a multiple.",
      "default": 1.0,
      "min": 0.6,
      "max": 1.6
    },
    "width": {
      "doc": "How broad each toe is, as a multiple of its thickness.",
      "default": 1.0,
      "min": 0.6,
      "max": 1.5
    },
    "point": {
      "doc": "How much narrower each toe is across than front to back, as a share: 0 for round toes, more for pointed ones.",
      "default": 0.0,
      "min": 0.0,
      "max": 0.6
    },
    "dewclaws": {
      "doc": "Builds two small dewclaws high at the back of the pastern: cattle, goats, sheep.",
      "default": false
    },
    "dewLow": {
      "doc": "Builds two larger dewclaws set lower at the back, standing out: a deer's.",
      "default": false
    },
    "dewLarge": {
      "doc": "Builds two large dewclaws low at the back, reaching nearly to the ground: a pig's.",
      "default": false
    },
    "heels": {
      "doc": "Builds two heel bulbs at the back of a single hoof, above the sole.",
      "default": false
    },
    "frog": {
      "doc": "Paints a frog on the sole: a wedge from the heels pointing forward to its middle, in the claw slot.",
      "default": false
    }
  },
