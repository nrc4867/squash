{
  "$schema": "../../schema/body-plan.schema.json",
  "format": 1,
  "id": "canine-quadruped",
  "version": 1,
  "name": "Canine quadruped",
  "root": { "template": "torso", "rest": [1, 0, 0] },
  "sockets": [
    { "name": "neck",      "on": "torso", "u": 0.92, "v": 0.04, "takes": ["head"] },
    { "name": "front-leg", "on": "torso", "u": 0.82, "v": 0.42, "pair": "x", "sink": 1.6, "takes": ["leg"] },
    { "name": "back-leg",  "on": "torso", "u": 0.18, "v": 0.42, "pair": "x", "sink": 1.6, "takes": ["leg"] },
    { "name": "tail",      "on": "torso", "u": 0.03, "v": 0.02, "sink": 1.2, "takes": ["tail"] },
    { "name": "ruff",      "on": "torso", "u": 0.9,  "v": 0.5,  "takes": ["ruff"], "optional": true }
  ],
  "slots": [
    { "name": "paw-claws", "on": "paw", "takes": ["claws"], "default": null }
  ],
  "palette": [
    { "name": "fur",       "color": { "red": 0.91, "green": 0.64, "blue": 0.29 } },
    { "name": "cream",     "color": { "red": 0.96, "green": 0.90, "blue": 0.78 } },
    { "name": "pad",       "color": { "red": 0.91, "green": 0.60, "blue": 0.65 } },
    { "name": "nose",      "color": { "red": 0.16, "green": 0.11, "blue": 0.12 } },
    { "name": "inner-ear", "color": { "red": 0.91, "green": 0.60, "blue": 0.65 } },
    { "name": "ink",       "color": { "red": 0.11, "green": 0.08, "blue": 0.09 } }
  ],
  "base": "fur"
}
