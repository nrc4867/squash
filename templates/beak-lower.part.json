{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "beak-lower",
  "version": 1,
  "name": "Lower beak",
  "role": "jaw",
  "axis": { "rest": [1, 0, 0], "length": 0.27 },
  "openEnd": "start",
  "topology": { "rings": 24, "segments": 16 },
  "views": { "side": "height", "top": "width", "front": "section" },
  "section": "circle",
  "params": {
    "size":  { "default": 1.0,  "min": 0.4, "max": 2.5 },
    "depth": { "default": 0.15, "min": 0.05, "max": 0.6 }
  },
  "blocks": [
    { "kind": "tube",   "u": [0.0, 1.0], "radius": "$depth", "taper": 0.2, "drop": 0.03 },
    { "kind": "cap",    "end": "end", "shape": "pointed" },
    { "kind": "joint",  "name": "jaw", "u": 0.0, "hinge": "x", "limits": [0, 30] },
    { "kind": "area",   "name": "tip", "u": [0.75, 1.0], "v": [0, 1], "tag": "fill" }
  ]
}
