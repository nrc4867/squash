{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "tube",
  "version": 1,
  "name": "Tube",
  "axis": { "rest": [1, 0, 0], "length": 0.6 },
  "openEnd": "start",
  "topology": { "rings": 32, "segments": 16 },
  "views": { "side": "height", "top": "width", "front": "section" },
  "section": "circle",
  "params": {
    "size":  { "default": 1.0,  "min": 0.4, "max": 2.5 },
    "girth": { "default": 0.15, "min": 0.04, "max": 0.7 }
  },
  "generic": { "rings": { "min": 8, "max": 96 }, "segments": { "min": 6, "max": 32 } },
  "blocks": [
    { "kind": "tube",  "u": [0.0, 1.0], "radius": "$girth" },
    { "kind": "cap",   "end": "end", "shape": "round" },
    { "kind": "joint", "name": "base", "u": 0.0, "hinge": "x", "limits": [-60, 60] }
  ]
}
