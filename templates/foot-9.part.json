  "params": {
    "size": {
      "doc": "Scales the part: its drawn length and width together.",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5
    },
    "toes": {
      "doc": "Toes built: 0 for a bare sole (a shoe), else 1 to 5, each count laid out across the ball of its own.",
      "default": 5,
      "values": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    },
    "toeLength": {
      "doc": "Multiplies every toe's length: below 1 short toes.",
      "default": 1.0,
      "min": 0.4,
      "max": 2.0
    },
    "toeThickness": {
      "doc": "Multiplies every toe's thickness: above 1 wide toes.",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0
    },
    "heel": {
      "doc": "Heel ball's radius, a fraction of the foot's length.",
      "default": 0.1333,
      "min": 0.05,
      "max": 0.3
    },
    "ballWidth": {
      "doc": "Half width across the ball of the foot, a fraction of the length.",
      "default": 0.1519,
      "min": 0.08,
      "max": 0.35
    },
    "ankle": {
      "doc": "Ankle's radius where the leg meets the foot; the heel sits back and the ankle bones swell out by it.",
      "default": 0.1111,
      "min": 0.05,
      "max": 0.3
    },
    "toeBox": {
      "doc": "Builds a rounded toe box in place of toes, for a shoe; set toes 0 with it.",
      "default": false
    },
    "toeTip": {
      "doc": "How far forward the toe box reaches, a fraction of the length.",
      "default": 0.663,
      "min": 0.5,
      "max": 1.0
    },
    "toeRound": {
      "doc": "Radius of the toe box's front end.",
      "default": 0.0741,
      "min": 0.02,
      "max": 0.15
    },
    "pitch": {
      "doc": "Degrees the forefoot turns up from the ball; negative points it down.",
      "default": 0,
      "min": -40,
      "max": 40,
      "unit": "deg"
    },
    "web": {
      "doc": "Radius of the smooth join between the toes and the foot.",
      "default": 0.04,
      "min": 0.0,
      "max": 0.12
    },
    "spread": {
      "doc": "Multiplies the fan angle of the toes and the gap between their roots: below 1 closer, above 1 wider.",
      "default": 1.0,
      "min": 0.3,
      "max": 1.8
    },
    "merge": {
      "doc": "How much neighbouring toes fuse: small stands them apart, 1 or more joins them to the tips.",
      "default": 0.35,
      "min": 0.0,
      "max": 2.0
    },
    "claw": {
      "doc": "How far each toe's nail stands past its tip as a claw; 0 for flat nails.",
      "default": 0.0,
      "min": 0.0,
      "max": 2.0
    },
    "clawCurl": {
      "doc": "How much each claw curls down (positive) or up (negative).",
      "default": 0.35,
      "min": -1.0,
      "max": 1.0
    },
    "pads": {
      "doc": "Builds a pad under each toe tip in the slot pad.",
      "default": false
    },
    "beans": {
      "doc": "How far each toe pad rises from its toe.",
      "default": 0.0,
      "min": 0.0,
      "max": 0.8
    },
    "webbing": {
      "doc": "Builds a thin skin web between neighbouring toes, inked along its free edge only.",
      "default": false
    },
    "webReach": {
      "doc": "How far up the toes the web reaches from where they leave the foot: 1 a full web to the tips, 0.5 a half web.",
      "default": 1.0,
      "min": 0.2,
      "max": 1.0
    },
    "webEdge": {
      "doc": "How far the web's free edge dips between two digits, as a share of its reach: 0 a straight edge, more a scalloped one.",
      "default": 0.25,
      "min": 0.0,
      "max": 0.6
    },
    "webThickness": {
      "doc": "How thick the web is half way between two digits, as a share of their thickness.",
      "default": 0.3,
      "min": 0.1,
      "max": 0.8
    }
  },
