{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "beak",
  "version": 1,
  "name": "Beak",
  "role": "jaw",
  "axis": { "rest": [1, 0, 0], "length": 0.3 },
  "openEnd": "start",
  "topology": { "rings": 32, "segments": 16 },
  "views": { "side": "height", "top": "width", "front": "section" },
  "section": "circle",
  "params": {
    "size":  { "default": 1.0,  "min": 0.4, "max": 2.5 },
    "depth": { "default": 0.2,  "min": 0.05, "max": 0.6 }
  },
  "blocks": [
    { "kind": "tube",   "u": [0.0, 1.0], "radius": "$depth", "taper": 0.15, "drop": 0.06 },
    { "kind": "cap",    "end": "end", "shape": "pointed" },
    { "kind": "joint",  "name": "base",  "u": 0.0, "hinge": "x", "limits": [-10, 10] },
    { "kind": "socket", "name": "lower", "u": 0.05, "v": 0.5, "outward": "axis", "takes": ["beak-lower"] },
    { "kind": "area",   "name": "tip", "u": [0.75, 1.0], "v": [0, 1], "tag": "fill" },
    { "kind": "area",   "name": "ridge", "u": [0.0, 1.0], "v": [0.85, 0.15], "tag": "fill" }
  ]
}
