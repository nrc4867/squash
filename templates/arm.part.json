{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "arm",
  "version": 1,
  "name": "Arm",
  "role": "arm",
  "axis": { "rest": [0.12, -0.993, 0], "length": 0.5 },
  "openEnd": "start",
  "topology": { "rings": 48, "segments": 24 },
  "views": { "side": "height", "top": "width", "front": "cap" },
  "section": "circle",
  "params": {
    "size":      { "default": 1.0,  "min": 0.4, "max": 2.5 },
    "thickness": { "default": 0.13, "min": 0.06, "max": 0.6 }
  },
  "blocks": [
    { "kind": "tube",   "u": [0.0, 1.0], "radius": "$thickness" },
    { "kind": "joint",  "name": "shoulder", "u": 0.0,  "hinge": "x", "limits": [-90, 170] },
    { "kind": "joint",  "name": "elbow",    "u": 0.5,  "hinge": "x", "limits": [-145, 0] },
    { "kind": "joint",  "name": "wrist",    "u": 1.0,  "hinge": "x", "limits": [-70, 70], "stretch": true },
    { "kind": "socket", "name": "hand",     "u": 1.0,  "v": 0.5, "outward": "normal", "takes": ["hand"] },
    { "kind": "area",   "name": "elbow",    "u": [0.45, 0.55], "v": [0, 1], "tag": "rigid" },
    { "kind": "area",   "name": "sleeve",   "u": [0.0, 0.45], "v": [0, 1], "tag": "fill" },
    { "kind": "area",   "name": "cuff",     "u": [0.8, 1.0], "v": [0, 1], "tag": "fill" }
  ]
}
