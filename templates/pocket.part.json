{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "pocket",
  "version": 1,
  "name": "Pocket",
  "role": "other",
  "axis": { "rest": [0, -1, 0], "length": 0.12 },
  "openEnd": "start",
  "topology": { "rings": 18, "segments": 24 },
  "views": { "side": "height", "top": "width" },
  "section": "circle",
  "join": { "ink": true },
  "params": {
    "size":   { "doc": "Scales the part: its depth and mouth together.", "default": 1.0, "min": 0.1, "max": 3.0 },
    "open":   { "doc": "Radius of the mouth, a fraction of the depth: small for a slit or a nostril, large for a wide pouch.", "default": 0.3, "min": 0.05, "max": 1.0 },
    "inside": { "doc": "How much wider the hollow is at its bottom than at its mouth.", "default": 1.3, "min": 0.5, "max": 3.0 },
    "width":  { "doc": "The mouth's width across as a share of its height: below 1 a slit standing up, above 1 one lying across.", "default": 1.0, "min": 0.2, "max": 4.0 }
  },
  "blocks": [
    { "kind": "tube", "u": [0.0, 1.0], "radius": "$open", "taper": "$inside", "width": "$width" },
    { "kind": "cap", "end": "end", "shape": "round" },
    { "kind": "pocket", "rim": 0.25, "wall": 0.6 },
    { "kind": "area", "name": "inside", "u": [0.12, 1.0], "v": [0, 1], "tag": "fill", "color": "nose" }
  ]
}
