  "params": {
    "size": {
      "doc": "Scales the part: its drawn length and width together.",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5
    },
    "digits": {
      "doc": "Digits built, the thumb among them: 5 a person's hand, 4 a cartoon's three fingers and a thumb, down to 2.",
      "default": 5,
      "values": [
        2,
        3,
        4,
        5
      ]
    },
    "thumb": {
      "doc": "Builds a thumb as one of the digits; off, every digit is a finger.",
      "default": true
    },
    "palmLength": {
      "doc": "Palm's half length, a fraction of the hand's length.",
      "default": 0.2273,
      "min": 0.1,
      "max": 0.4
    },
    "palmWidth": {
      "doc": "Palm's half width across the knuckles.",
      "default": 0.16,
      "min": 0.08,
      "max": 0.35
    },
    "palmThickness": {
      "doc": "Palm's half thickness, back to front.",
      "default": 0.0705,
      "min": 0.03,
      "max": 0.2
    },
    "wrist": {
      "doc": "Wrist's radius where the arm meets the hand.",
      "default": 0.1091,
      "min": 0.04,
      "max": 0.25
    },
    "fingerLength": {
      "doc": "Multiplies every finger's length.",
      "default": 1.0,
      "min": 0.5,
      "max": 1.6
    },
    "fingerThickness": {
      "doc": "Multiplies every finger's thickness.",
      "default": 1.0,
      "min": 0.5,
      "max": 1.8
    },
    "cup": {
      "doc": "How far the palm's edges curl toward the palm side into a cup; negative arches it back.",
      "default": 0.02,
      "min": -0.05,
      "max": 0.15
    },
    "web": {
      "doc": "Radius of the smooth join between the fingers and the palm.",
      "default": 0.025,
      "min": 0.0,
      "max": 0.12
    },
    "knuckles": {
      "doc": "Knuckle ball at each finger's root, a share of the finger's radius; 0 for none.",
      "default": 0.85,
      "min": 0.0,
      "max": 1.5
    },
    "spread": {
      "doc": "Multiplies the fingers' fan angle across the palm: below 1 closer, above 1 spread wide.",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0
    },
    "merge": {
      "doc": "How much neighbouring fingers fuse: small stands them apart to their roots, 1 or more joins them to the tips as a mitten.",
      "default": 0.1,
      "min": 0.0,
      "max": 2.0
    },
    "webbing": {
      "doc": "Builds a thin skin web between neighbouring fingers, inked along its free edge only.",
      "default": false
    },
    "webReach": {
      "doc": "How far up the fingers the web reaches from where they leave the palm: 1 a full web to the tips, 0.5 a half web.",
      "default": 1.0,
      "min": 0.2,
      "max": 1.0
    },
    "webEdge": {
      "doc": "How far the web's free edge dips between two digits, as a share of its reach: 0 a straight edge, more a scalloped one.",
      "default": 0.25,
      "min": 0.0,
      "max": 0.6
    },
    "webThickness": {
      "doc": "How thick the web is half way between two digits, as a share of their thickness.",
      "default": 0.3,
      "min": 0.1,
      "max": 0.8
    }
  },
