{
  "$schema": "../schema/part-template.schema.json",
  "format": 1,
  "id": "paw",
  "version": 13,
  "name": "Paw",
  "role": "foot",
  "axis": {
    "rest": [
      1,
      0,
      0
    ],
    "length": 0.3
  },
  "openEnd": null,
  "topology": {
    "rings": 36,
    "segments": 32
  },
  "views": {
    "side": "height",
    "top": "width",
    "front": "section"
  },
  "section": "sole",
  "join": {
    "blend": 0.06
  },
  "params": {
    "size": {
      "doc": "Scales the part: its drawn length and width together.",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5
    },
    "toes": {
      "doc": "Toes built: 0 for none (a mitten or a boot), else 1 to 5, each count laid out across the paw of its own.",
      "default": 4,
      "values": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    },
    "toeLength": {
      "doc": "Multiplies every toe's length.",
      "default": 1.0,
      "min": 0.4,
      "max": 2.0
    },
    "toeThickness": {
      "doc": "Multiplies every toe's thickness.",
      "default": 1.0,
      "min": 0.5,
      "max": 1.8
    },
    "spread": {
      "doc": "Multiplies the fan angle of the toes and the gap between their roots: below 1 closer, above 1 wider.",
      "default": 1.0,
      "min": 0.3,
      "max": 1.8
    },
    "merge": {
      "doc": "How much neighbouring toes fuse: 0.15 to 0.3 stand clear, about 1 a mitten.",
      "default": 0.25,
      "min": 0.0,
      "max": 2.0
    },
    "web": {
      "doc": "Radius of the smooth join between the toes and the paw.",
      "default": 0.05,
      "min": 0.0,
      "max": 0.2
    },
    "claws": {
      "doc": "Builds claws; off retracts them.",
      "default": true
    },
    "claw": {
      "doc": "How far each claw stands past its toe tip.",
      "default": 0.45,
      "min": 0.0,
      "max": 2.0
    },
    "clawCurl": {
      "doc": "How much each claw curls down (positive) or up (negative).",
      "default": 0.35,
      "min": -1.0,
      "max": 1.0
    },
    "pads": {
      "doc": "Builds the toe beans and the main pad.",
      "default": true
    },
    "beans": {
      "doc": "How far each toe bean rises from its toe.",
      "default": 0.0,
      "min": 0.0,
      "max": 0.8
    },
    "heel": {
      "doc": "Half width of the heel ball at the paw's back.",
      "default": 0.11,
      "min": 0.06,
      "max": 0.35
    },
    "width": {
      "doc": "Half width of the paw's main pad, a fraction of the length.",
      "default": 0.2,
      "min": 0.08,
      "max": 0.4
    },
    "height": {
      "doc": "Half height of the paw's main pad, a fraction of the length.",
      "default": 0.19,
      "min": 0.08,
      "max": 0.4
    },
    "limb": {
      "doc": "Radius of the limb end it sits on, a fraction of its length; read from the limb's end when left unset, so the ankle or wrist runs on from it with no step.",
      "default": 0.09,
      "min": 0.02,
      "max": 0.4
    },
    "webbing": {
      "doc": "Builds a thin skin web between neighbouring toes, inked along its free edge only.",
      "default": false
    },
    "webReach": {
      "doc": "How far up the toes the web reaches from where they leave the foot: 1 a full web to the tips, 0.5 a half web.",
      "default": 1.0,
      "min": 0.2,
      "max": 1.0
    },
    "webEdge": {
      "doc": "How far the web's free edge dips between two digits, as a share of its reach: 0 a straight edge, more a scalloped one.",
      "default": 0.25,
      "min": 0.0,
      "max": 0.6
    },
    "webThickness": {
      "doc": "How thick the web is half way between two digits, as a share of their thickness.",
      "default": 0.3,
      "min": 0.1,
      "max": 0.8
    },
    "clawParts": {
      "doc": "Builds a hard claw on every toe's tip as its own mesh, inked and coloured on its own with a collar where it leaves the toe, riding bones of its own that a pose slides back into the toe; the nails or grown claws are left out while it is on.",
      "default": false
    },
    "clawLength": {
      "doc": "How far each hard claw reaches past its tip, as a share of its toe's length.",
      "default": 0.45,
      "min": 0.1,
      "max": 1.5
    },
    "clawThickness": {
      "doc": "Each hard claw's height at its root, as a share of the tip's thickness.",
      "default": 0.5,
      "min": 0.2,
      "max": 1.0
    },
    "clawHook": {
      "doc": "How far each hard claw hooks toward the underside from root to point: 0 straight, 1 a full hook.",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    "clawSheath": {
      "doc": "How wide the collar round each hard claw's root swells, 0 to 1: the skin it leaves the toe through.",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    }
  },
